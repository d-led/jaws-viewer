{
  "threshold": 0.5,
  "reporters": ["consoleFull"],
  "mode": "strict",
  "minLines": 7,
  "minTokens": 80,
  "format": ["typescript", "javascript", "css"],
  "ignore": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/e2e/.bundle/**",
    "**/data/**",
    "**/*.json"
  ]
}
